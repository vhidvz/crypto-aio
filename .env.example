# Copy to .env for LOCAL integration tests only. Never commit .env.
# The library reads routing configuration from the environment, never private keys:
#   CRYPTO_AIO_ENV=<profile>
#   CRYPTO_AIO_[<PROFILE>_]<CHAIN>_{NETWORK|LIBRARY|PROVIDER|RPC_URL|INDEXER_URL}
# CRYPTO_AIO_ENV=test
# CRYPTO_AIO_TEST_ETHEREUM_NETWORK=sepolia
# CRYPTO_AIO_TEST_ETHEREUM_RPC_URL=

# Opt-in integration tests (unit tests never use the network)
# CRYPTO_AIO_INTEGRATION=1
# CRYPTO_AIO_INTEGRATION_WRITE=1

# Funded throwaway keys, read ONLY by integration test code (never by the library)
# CRYPTO_AIO_TEST_ETHEREUM_PRIVATE_KEY=
