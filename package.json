{
  "name": "crypto-aio",
  "version": "0.1.0-dev.0",
  "description": "Blockchain abstraction layer for exchanges, wallets and payment infrastructure: one consistent API over EVM, Tron, Bitcoin, Solana and TON SDKs",
  "license": "MIT",
  "author": "Vahid V. <vhid.vz@gmail.com>",
  "repository": { "type": "git", "url": "git+https://github.com/vhidvz/crypto-aio.git" },
  "bugs": { "url": "https://github.com/vhidvz/crypto-aio/issues" },
  "homepage": "https://github.com/vhidvz/crypto-aio#readme",
  "keywords": ["blockchain", "crypto", "exchange", "wallet", "ethereum", "bitcoin", "tron", "solana", "ton", "evm"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./evm": { "types": "./dist/adapters/evm/index.d.ts", "default": "./dist/adapters/evm/index.js" },
    "./native": { "types": "./dist/native.d.ts", "default": "./dist/native.js" },
    "./testing": { "types": "./dist/testing/index.d.ts", "default": "./dist/testing/index.js" },
    "./tron": { "types": "./dist/adapters/tron/index.d.ts", "default": "./dist/adapters/tron/index.js" },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "evm": ["dist/adapters/evm/index.d.ts"],
      "native": ["dist/native.d.ts"],
      "testing": ["dist/testing/index.d.ts"],
      "tron": ["dist/adapters/tron/index.d.ts"]
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{js,mjs}\"",
    "test": "jest",
    "test:coverage": "jest --coverage && make-coverage-badge --report-path docs/coverage/coverage-summary.json --output-path docs/coverage.svg",
    "doc": "typedoc",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "debug": "^4.4.3"
  },
  "peerDependencies": {
    "ethers": "^6.17.0",
    "tronweb": "^6.5.1",
    "web3": "^4.16.0"
  },
  "peerDependenciesMeta": {
    "ethers": { "optional": true },
    "tronweb": { "optional": true },
    "web3": { "optional": true }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/debug": "^4.1.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "ethers": "6.17.0",
    "jest": "^30.5.2",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "tronweb": "6.5.1",
    "ts-jest": "29.4.12",
    "typedoc": "^0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "web3": "4.16.0"
  },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" }
}
